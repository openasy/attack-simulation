{
 "openapi": "3.1.1",
 "info": {
  "title": "OpenAsy Attack Simulation API",
  "version": "0.1.0",
  "summary": "Run harmless MITRE ATT&CK techniques from a fixed pack on hosts you allow, then check whether the detecting products saw them, and read coverage per technique.",
  "description": "Every screen of Attack Simulation uses this API, and so can your scripts (ADR 0014). Within `/api/v1` changes are additive only; anything removed is deprecated first. Errors use Problem Details (RFC 9457).\n\nattack-simulation-agent enrols with a one-time or fleet enrolment token at `/api/v1/agent/enroll` and then calls `/api/v1/agent/*` with its own secret, which speaks for its host only. The server sends an agent only a test's pack id and a random marker, never a command; the agent runs the test from its own built-in pack and refuses any id it does not have (ADR 0072). Everything else takes the session of a signed-in person or an API token, and each operation names the role it needs (`x-openasy-role`: viewer, editor, admin; ADR 0003).\n\nSign-in, members and API tokens are under `/api/v1/auth`, provided by [@openasy/auth](https://github.com/openasy/auth#routes).",
  "license": {
   "name": "AGPL-3.0-only",
   "identifier": "AGPL-3.0-only"
  }
 },
 "servers": [
  {
   "url": "/",
   "description": "This install"
  }
 ],
 "tags": [
  {
   "name": "Tests",
   "description": "The fixed, reviewed pack of benign tests."
  },
  {
   "name": "Runs",
   "description": "Runs of the pack on a host, and their steps."
  },
  {
   "name": "Coverage",
   "description": "Which techniques are detected and which are missed."
  },
  {
   "name": "Hosts",
   "description": "Hosts with the agent, allowing them for simulation, and enrolment tokens."
  },
  {
   "name": "Agent",
   "description": "What attack-simulation-agent calls. The server never calls it."
  },
  {
   "name": "Product",
   "description": "Version, health and overview of this install."
  }
 ],
 "components": {
  "securitySchemes": {
   "session": {
    "type": "apiKey",
    "in": "cookie",
    "name": "__Host-openasy-session",
    "description": "The browser session after signing in (`openasy-session` on plain http://localhost). Requests that change something must come from this origin."
   },
   "apiToken": {
    "type": "http",
    "scheme": "bearer",
    "description": "An API token created under Settings, API tokens (`oa_attack-simulation_...`): one role, always an expiry (ADR 0003)."
   },
   "adminToken": {
    "type": "http",
    "scheme": "bearer",
    "description": "Only when the server is started by its tests or a local script: one shared token with the admin role. A production install does not have it."
   },
   "agentSecret": {
    "type": "http",
    "scheme": "bearer",
    "description": "The secret attack-simulation-agent got when it enrolled (`aia_...`). It speaks for its own host only."
   }
  },
  "responses": {
   "Problem": {
    "description": "An error, as RFC 9457 Problem Details.",
    "content": {
     "application/problem+json": {
      "schema": {
       "$ref": "#/components/schemas/Problem"
      }
     }
    }
   }
  },
